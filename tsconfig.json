{
  // 🧰 Type-check only (`npm run typecheck`). Node runs the .ts files directly
  // via type stripping, so no emit — and erasableSyntaxOnly keeps us from
  // writing enums/namespaces that Node's stripper can't handle.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
