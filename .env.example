# 📲 Pekzho-WhatsApp config. Copy to .env (chmod 600) — .env is gitignored.

# 🤝 Must match the "Verify token" configured in Meta → WhatsApp → Configuration.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# 🔏 Meta App Secret — when set, POST /webhook enforces X-Hub-Signature-256.
WHATSAPP_APP_SECRET=

# 📡 Graph API send credentials (System User token + the number's Phone Number ID).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1140071969198046
WHATSAPP_GRAPH_VERSION=v25.0

# 🐘 own DB inside pektown-pg
DATABASE_URL=postgres://pekzho_whatsapp:<password>@pektown-pg:5432/pekzho_whatsapp

# 🧠 DeepSeek (same upstream key as pektown-api's PEKTOWN_DEEPSEEK_API_KEY)
DEEPSEEK_API_KEY=
PEKZHO_MODEL=deepseek-flash
PEKZHO_TIMEZONE=Asia/Kolkata
HABIT_REMINDER_TIME=21:00

# 🧪 1 = log outbound messages instead of sending (testing only)
# WHATSAPP_DRY_RUN=1

# 🌐 Browserbase — remote Chrome for the attendance login (Live View)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# 📜 out-of-window reminder template (Meta-approved) + the WABA that owns it
WHATSAPP_WABA_ID=923879640648428
HABIT_REMINDER_TEMPLATE=habit_checklist_reminder
HABIT_REMINDER_TEMPLATE_LANG=en

# 🎙️ voice notes → text
OPENAI_API_KEY=
PEKZHO_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# 🔗 public base for the attendance sign-in link (default https://pk.pekzho.com)
# PEKZHO_PUBLIC_URL=https://pk.pekzho.com
